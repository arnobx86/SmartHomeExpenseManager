<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.arnobx86.smarthomeexpensemanager.DashboardController">
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: #f0f0f0;">
            <Label text="Total Expense: " style="-fx-font-weight: bold;"/>
            <Label fx:id="totalExpenseLabel" text="0.00"/>
            <Label text="Monthly Income: " style="-fx-font-weight: bold;"/>
            <Label fx:id="monthlyIncomeLabel" text="0.00"/>
            <Label text="Savings: " style="-fx-font-weight: bold;"/>
            <Label fx:id="savingsLabel" text="0.00"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="10" style="-fx-padding: 10; -fx-border-color: #cccccc; -fx-border-width: 0 1 0 0;">
            <Label text="Add Expense" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <TextField fx:id="expenseAmountField" promptText="Amount"/>
            <HBox spacing="5">
                <ComboBox fx:id="categoryComboBox" promptText="Category" prefWidth="120"/>
                <Button text="Manage" onAction="#onManageCategoriesClick" style="-fx-font-size: 10px;"/>
            </HBox>
            <DatePicker fx:id="expenseDatePicker" promptText="Date"/>
            <Button text="Add Expense" onAction="#onAddExpenseClick" maxWidth="Infinity"/>

            <Label text="Set Income" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 20 0 0 0;"/>
            <TextField fx:id="incomeField" promptText="Monthly Income"/>
            <Button text="Set Income" onAction="#onSetIncomeClick" maxWidth="Infinity"/>

            <Button text="Generate Report" onAction="#onGenerateReportClick" maxWidth="Infinity" style="-fx-margin: 20 0 0 0;"/>
        </VBox>
    </left>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Overview">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Filter Month:"/>
                        <DatePicker fx:id="filterDatePicker" onAction="#onFilterDateChange"/>
                        <Button text="Clear Filter" onAction="#onClearFilterClick"/>
                    </HBox>

                    <TableView fx:id="expenseTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" text="ID"/>
                            <TableColumn fx:id="colCategory" text="Category"/>
                            <TableColumn fx:id="colAmount" text="Amount"/>
                            <TableColumn fx:id="colDate" text="Date"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                    <HBox spacing="10" prefHeight="300">
                        <PieChart fx:id="expensePieChart" title="Expense Distribution"/>
                        <BarChart fx:id="expenseBarChart" title="Expenses by Category">
                            <xAxis><CategoryAxis label="Category"/></xAxis>
                            <yAxis><NumberAxis label="Amount"/></yAxis>
                        </BarChart>
                    </HBox>
                </VBox>
            </Tab>
            <Tab text="Analysis">
                <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
                    <Label text="Monthly Expense Comparison (Current Year)" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <BarChart fx:id="monthlyExpenseBarChart">
                        <xAxis><CategoryAxis label="Month"/></xAxis>
                        <yAxis><NumberAxis label="Total Expense"/></yAxis>
                    </BarChart>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
